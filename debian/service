[Unit]
Description=gofaxserver - Multi-tenant Fax over IP server
Documentation=https://github.com/sagostin/gofaxserver
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=gofax
Group=gofax
ExecStart=/usr/bin/gofaxserver -c /etc/gofaxserver/config.json
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/gofaxserver /tmp /etc/freeswitch/gateways

# IP sentry (security.enabled=true in config.json): uncomment to let the
# service program nftables/ipset rules for dynamic SIP brute-force banning.
# Also install the nftables (or ipset) package on the host.
#AmbientCapabilities=CAP_NET_ADMIN
#CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
