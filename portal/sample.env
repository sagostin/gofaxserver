# Portal environment (used by portal/docker-compose.yml)
# Copy to .env next to the compose file or export in your shell.

# Set true once the portal is served over HTTPS (e.g. behind Caddy).
# Set false for plain-HTTP local testing (Secure cookies are not sent over
# http://, so login will appear to fail silently otherwise).
PORTAL_COOKIE_SECURE=true

# The compose stack runs its own dedicated PostgreSQL container on port 5433
# (separate from gofaxserver's database on 5432; creds/database are
# auto-created from the values below on first boot). Only change these if you
# point the portal at an external PostgreSQL instance instead.
PORTAL_DB_HOST=127.0.0.1
PORTAL_DB_PORT=5433
PORTAL_DB_USER=gofaxportal
PORTAL_DB_PASSWORD=change-me
PORTAL_DB_NAME=gofaxportal
# Portal DB bind address: 127.0.0.1 = localhost only (default, recommended).
# Set 0.0.0.0 temporarily for remote debug access (GUI client, another host)
# — firewall :5433 to trusted IPs when you do.
PORTAL_DB_LISTEN_ADDRESSES=127.0.0.1

# Long random strings — required.
PORTAL_SESSION_SECRET=change-me-long-random-string-1
PORTAL_ENCRYPTION_KEY=change-me-long-random-string-2

# Where gofaxserver lives and its admin API key (web.api_key).
PORTAL_GOFAX_BASE_URL=http://127.0.0.1:8080
PORTAL_ADMIN_API_KEY=change-me-gofaxserver-api-key

# Optional pre-shared key gofaxserver must send (as X-API-Key) when
# delivering received faxes to POST /portal/api/inbound/<svc_username>.
# Must match gofaxserver's config: portal.api_key. Empty disables the check
# (fine when both services are loopback-only).
PORTAL_INBOUND_API_KEY=

# Comma-separated direct-peer IPs/CIDRs whose X-Forwarded-For / X-Real-IP
# headers are trusted when resolving the client IP (audit log, rate limits).
# Defaults to loopback (Caddy on the same host). Any other peer's forwarded
# headers are ignored so client IPs cannot be spoofed.
# PORTAL_TRUSTED_PROXIES=127.0.0.1,::1

# First admin account, created when the portal user table is empty.
# This is a PORTAL login only — unrelated to any gofaxserver accounts.
# One-time: once an admin exists, these can be blanked/removed.
PORTAL_BOOTSTRAP_USERNAME=admin
PORTAL_BOOTSTRAP_PASSWORD=
PORTAL_BOOTSTRAP_EMAIL=
