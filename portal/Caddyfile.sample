# Fax Portal — Caddy reverse proxy with automatic HTTPS.
#
# Single hostname split by path:
#   https://fax.example.com/portal/*        → portal  (127.0.0.1:8081)
#   https://fax.example.com/fax/send, /admin/*, … → gofaxserver (127.0.0.1:8080)
#
# Existing gofaxserver API clients keep working byte-for-byte through the
# same hostname (or can keep hitting :8080 directly — either works).
#
# Setup:
# 1. Copy this file to `Caddyfile` next to docker-compose.yml and set your
#    DNS name (must resolve to this host; 80/443 reachable for Let's Encrypt).
# 2. Start:  docker compose --profile tls up -d

fax.example.com {
	encode gzip

	# Portal UI + portal API (path-prefixed).
	@portal path /portal /portal/*
	handle @portal {
		reverse_proxy 127.0.0.1:8081 {
			health_uri /portal/api/health
			health_interval 15s
			health_timeout 5s
		}
	}

	# Everything else: gofaxserver API, proxied through unchanged.
	# /fax/send, /fax/status, /tenant/user/authenticate, /admin/*, /health
	handle {
		reverse_proxy 127.0.0.1:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# ---------------------------------------------------------------------------
# Optional hardening: restrict the gofaxserver admin API by source IP while
# leaving tenant-user fax endpoints public:
#
# fax.example.com {
# 	@portal path /portal /portal/*
# 	handle @portal { reverse_proxy 127.0.0.1:8081 }
#
# 	@adminApi path /admin/*
# 	@internal remote_ip 10.0.0.0/8 192.168.0.0/16
# 	handle @adminApi {
# 		@notInternal not remote_ip 10.0.0.0/8 192.168.0.0/16
# 		respond @notInternal 403
# 		reverse_proxy 127.0.0.1:8080
# 	}
#
# 	handle { reverse_proxy 127.0.0.1:8080 }
# }
# ---------------------------------------------------------------------------
