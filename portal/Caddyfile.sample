# Fax Portal — Caddy reverse proxy with automatic HTTPS.
#
# 1. Copy this file to `Caddyfile` next to docker-compose.yml and set your
#    DNS name (it must resolve to this host; ports 80/443 must be reachable
#    for Let's Encrypt).
# 2. Start:  docker compose --profile tls up -d
#
# The portal listens on 127.0.0.1:8081 (host networking). gofaxserver (:8080)
# intentionally has NO public site block — its admin API should stay on the
# internal network / firewall.

fax.example.com {
	encode gzip

	# Reverse proxy to the portal.
	reverse_proxy 127.0.0.1:8081 {
		health_uri /api/health
		health_interval 15s
		health_timeout 5s
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# ---------------------------------------------------------------------------
# Optional: expose gofaxserver behind TLS for internal/admin use only.
# Prefer keeping :8080 firewalled; if you must expose it, restrict sources:
#
# api.example.com {
# 	@internal remote 10.0.0.0/8 192.168.0.0/16
# 	handle @internal {
# 		reverse_proxy 127.0.0.1:8080
# 	}
# 	respond 403
# }
# ---------------------------------------------------------------------------
