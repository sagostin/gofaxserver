<include>
	<gateway name="{{.name}}">
		<param name="realm" value="{{.realm}}"/>
		{{- if .username}}
		<param name="username" value="{{.username}}"/>
		<param name="password" value="{{.password}}"/>
		{{- end}}

		<param name="extension" value="{{.extension}}"/>
		<param name="caller-id-in-from" value="true"/>

		<!-- Use extension@ip in the contact instead of gw+gateway_name@ip -->
		<param name="extension-in-contact" value="true"/>

		<param name="register" value="{{if .register}}true{{else}}false{{end}}"/>

		<param name="ignore-early-media" value="true"/>
	</gateway>
</include>
