# PostgreSQL settings
POSTGRES_USER=fax
POSTGRES_PASSWORD=faxing123
POSTGRES_DB=fax
POSTGRES_HOST_AUTH_METHOD=scram-sha-256
# Bind address: 127.0.0.1 = localhost only (default, recommended).
# Set 0.0.0.0 temporarily to reach the DB from another host / GUI client
# while debugging — firewall :5432 to trusted IPs when you do.
#POSTGRES_LISTEN_ADDRESSES=127.0.0.1
POSTGRES_TIMEZONE=America/Vancouver

# SignalWire token — only needed for docker-compose.full.yml (builds the
# FreeSWITCH container image from SignalWire's authenticated apt repo).
# https://developer.signalwire.com/freeswitch/FreeSWITCH-Explained/Installation/how-to-create-a-personal-access-token
SIGNALWIRE_TOKEN=

# FTP backup upload (optional — leave blank to skip)
#FTP_HOST=ftp.example.com
#FTP_USER=backupuser
#FTP_PASS=backuppassword
#FTP_PORT=21
#FTP_REMOTE_DIR=/backups

# Backup retention (days)
#BACKUP_KEEP_DAYS=30